# Copy to .env.local (gitignored) or let ./scripts/bootstrap_gcp.sh / ./deploy.sh generate it.
GOOGLE_CLOUD_PROJECT=your-project-id
DLP_LOCATION=us-central1
DLP_KMS_KEY_NAME=projects/your-project-id/locations/us-central1/keyRings/secure-id-extract/cryptoKeys/dlp-wrap
# Base64 KMS ciphertext of a random 32-byte AES key (created by bootstrap_gcp.sh). Never the plaintext key.
DLP_WRAPPED_KEY=
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_INPUT_TEMPLATE=secure-id-input
MODEL_ARMOR_OUTPUT_TEMPLATE=secure-id-output

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global
# GEMINI_THINKING_LEVEL=low
# RATE_LIMIT_RPM=30
# Require X-API-Key on /api/extract:
# API_KEY=
# Enable /api/vault/reidentify (run.sh generates one per session):
# VAULT_API_KEY=
